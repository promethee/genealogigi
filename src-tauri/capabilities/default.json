{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/promethee/genealogigi/**" }]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "process:allow-exit",
    "store:default",
    "fs:allow-exists",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    }
  ]
}
