{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "tasks": {
    "dev": "deno task build:vue && deno desktop -A src/main.ts",
    "build": "deno task build:vue && deno desktop -A -o dist-app/genealogigi src/main.ts",
    "build:vue": "deno run -A npm:vite build",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check src/**/*.ts",
    "test": "deno test -A"
  },
  "compilerOptions": {
    "strict": true,
    "jsx": "precompile",
    "jsxImportSource": "vue",
    "lib": ["deno.window", "deno.desktop"]
  },
  "imports": {
    "vue": "npm:vue@^3.4.0",
    "pinia": "npm:pinia@^2.1.0"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["AGENTS.md", "DECISIONS.md", "TODO.md", "README.md"]
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  }
}
