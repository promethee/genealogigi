{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "tasks": {
    "dev": "deno task build:vue && deno desktop --hmr --include dist -A src/main.ts",
    "build": "deno task build:vue && deno desktop -A -o dist-app/genealogigi src/main.ts",
    "build:vue": "deno run -A npm:vite build",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check src/**/*.ts",
    "test": "deno test -A"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "jsx": "precompile",
    "jsxImportSource": "vue",
    "lib": ["deno.window", "deno.desktop"]
  },
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3",
    "@vitejs/plugin-vue": "npm:@vitejs/plugin-vue@^6.0.8",
    "vite": "npm:vite@^8.2.2",
    "vue": "npm:vue@^3.4.0",
    "pinia": "npm:pinia@^2.1.0"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["AGENTS.md", "DECISIONS.md", "TODO.md", "README.md"]
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  }
}
