{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "name": "genealogigi",
  "version": "0.1.0",
  "license": "MIT",
  "tasks": {
    "dev": "deno run -A --unstable-desktop src/main.ts",
    "build": "deno task build:vue && deno compile -A --unstable-desktop -o dist/genealogigi src/main.ts",
    "build:vue": "deno run -A npm:vite build",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check src/**/*.ts",
    "test": "deno test -A",
    "test:e2e": "deno run -A npm:playwright test"
  },
  "compilerOptions": {
    "strict": true,
    "jsx": "precompile",
    "jsxImportSource": "vue"
  },
  "imports": {
    "vue": "npm:vue@^3.4.0",
    "pinia": "npm:pinia@^2.1.0"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["AGENTS.md", "DECISIONS.md", "TODO.md", "README.md"]
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  }
}
