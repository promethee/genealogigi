#!/bin/sh
# Pre-commit hook – abort commit if any quality check fails

# Normalize line endings according to .gitattributes
git add --renormalize . || { echo "❌ git add --renormalize failed"; exit 1; }

npm run fmt:check || { echo "❌ prettier check failed (run: npm run fmt)"; exit 1; }
npm run lint || { echo "❌ eslint failed"; exit 1; }
npm run check || { echo "❌ type check failed"; exit 1; }
npm test || { echo "❌ unit tests failed"; exit 1; }

exit 0
